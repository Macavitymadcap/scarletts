// Static assets plus a small Worker script for the band's crew area. Only the
// paths in run_worker_first invoke the script; every other request is served
// from dist/ directly, costs nothing and never touches the script.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "scarletts",
	"compatibility_date": "2026-10-01",
	"main": "src/worker/index.ts",
	"assets": {
		"directory": "./dist",
		// Serves dist/404.html with a 404 status for unknown paths.
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/crew",
			"/crew/*",
			"/cal/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "scarletts-crew",
			"database_id": "ba9cf0dd-6a2d-48a9-92ea-67e9f39f067e",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// From Zero Trust > Access > Applications for the /crew application.
		"ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
		"ACCESS_AUD": "REPLACE_WITH_AUDIENCE_TAG",
		"GITHUB_REPO": "Macavitymadcap/scarletts"
	},
	"routes": [
		{
			"pattern": "scarletts.uk",
			"custom_domain": true
		}
	]
}